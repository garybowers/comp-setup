# On AC plug/unplug: switch power profile and dim/restore screen brightness
step "Installing AC/battery power profile + brightness switching"
sudo bash -c 'cat <<'\''EOF'\'' > /usr/local/bin/power-source-changed
#!/bin/sh
# Called by udev on AC plug/unplug: $1 = battery | ac
# battery: power-saver profile, remember brightness, dim to 40% if brighter
# ac:      balanced profile, restore remembered brightness
STATE=/run/power-source-brightness
DIM=40

case "$1" in
battery)
	powerprofilesctl set power-saver
	if [ ! -f "$STATE" ]; then
		cur=$(brightnessctl -m | cut -d, -f4 | tr -d %)
		echo "$cur" > "$STATE"
		[ "$cur" -gt "$DIM" ] && brightnessctl -q set "$DIM%"
	fi
	;;
ac)
	powerprofilesctl set balanced
	if [ -f "$STATE" ]; then
		brightnessctl -q set "$(cat "$STATE")%"
		rm -f "$STATE"
	fi
	;;
esac
exit 0
EOF'
sudo chmod 755 /usr/local/bin/power-source-changed
sudo bash -c 'cat <<EOF > /etc/udev/rules.d/99-power-profile.rules
# Switch power profile and brightness on AC plug/unplug
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/usr/local/bin/power-source-changed battery"
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/usr/local/bin/power-source-changed ac"
EOF'
sudo udevadm control --reload

# Deepest PCIe link power saving (set at boot, so no bootloader changes needed)
# and no NMI watchdog (a periodic timer that keeps waking the CPU)
step "Enabling PCIe ASPM power saving and disabling NMI watchdog"
sudo bash -c 'cat <<EOF > /etc/tmpfiles.d/pcie-aspm.conf
w /sys/module/pcie_aspm/parameters/policy - - - - powersupersave
EOF'
sudo bash -c 'cat <<EOF > /etc/sysctl.d/99-power-saving.conf
kernel.nmi_watchdog = 0
EOF'

