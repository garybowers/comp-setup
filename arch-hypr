#!/usr/bin/env bash
set -euo pipefail

# Directory this script lives in (the comp-setup repo). Resolved up front
# because later steps change the working directory.
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Print a highlighted step banner so progress is visible while the script runs.
step() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }

# ---------------------------------------------------------------------------
# Desktop configs: copy dotfiles/ from this repo into ~/.config
# ---------------------------------------------------------------------------
# Runs as the last step of this script. To redeploy just the configs after
# editing them (no packages, no sudo), run:   ./arch-hypr --dotfiles
#
# Copies real files (NOT symlinks back into this repo):
#   hypr/    hyprland.lua, hypridle.conf, hyprpaper.conf, hyprlock.conf,
#            hosts/ (per-machine settings, picked by hostname), switch.sh, dpms.sh, dpms-resume.sh
#   kitty/   kitty.conf
#   rofi/    config.rasi
#   waybar/  config.jsonc, style.css, power_menu.xml, scripts/
#   themes/  the theme system (set-theme.sh + themes/<name>/…)
#   qt6ct/   qt6ct.conf (dark Qt theme)
#   uwsm/    env (session environment when logging in via uwsm)
#   chrome-flags.conf  flags the google-chrome launcher reads on every start
#   systemd/user/waybar.service
#   .bashrc, .vimrc    copied to the home directory
#
# Any existing target is backed up to <name>.bak.<timestamp> first, so it is
# safe to re-run. After copying, it applies the active theme, which creates the
# per-app theme symlinks (theme.css / theme.conf / theme.rasi /
# hyprlock-theme.conf / current-wallpaper) that the base configs import.
install_dotfiles() {
  local SRC="$REPO_DIR/dotfiles"
  local CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
  local STAMP THEME
  STAMP="$(date +%Y%m%d-%H%M%S)"

  say()  { printf '\033[1;32m::\033[0m %s\n' "$*"; }
  warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

  backup() {  # move an existing file/dir/symlink aside
    local p="$1"
    if [ -e "$p" ] || [ -L "$p" ]; then
      mv "$p" "$p.bak.$STAMP"
      echo "   backed up $(basename "$p") -> $(basename "$p").bak.$STAMP"
    fi
  }

  install_dir() {  # install_dir <name> : copy SRC/<name>/ -> CFG/<name>/
    local name="$1" s="$SRC/$1" d="$CFG/$1"
    [ -d "$s" ] || { warn "skip $name (missing in repo)"; return; }
    backup "$d"
    mkdir -p "$d"
    cp -a "$s/." "$d/"
    say "installed $name"
  }

  # Preserve the currently-active theme across a re-install; default to tokyo-night.
  THEME="tokyo-night"
  if [ -L "$CFG/themes/current" ]; then
    THEME="$(basename "$(readlink -f "$CFG/themes/current")")"
  fi

  say "Installing configs into $CFG"
  install_dir hypr
  install_dir kitty
  install_dir rofi
  install_dir waybar
  install_dir themes
  install_dir qt6ct
  install_dir uwsm

  if [ -f "$SRC/chrome-flags.conf" ]; then
    backup "$CFG/chrome-flags.conf"
    cp -a "$SRC/chrome-flags.conf" "$CFG/chrome-flags.conf"
    say "installed chrome-flags.conf"
  fi

  # shell + editor dotfiles live in $HOME, not ~/.config
  local f
  for f in .bashrc .vimrc; do
    if [ -f "$SRC/$f" ]; then
      backup "$HOME/$f"
      cp -a "$SRC/$f" "$HOME/$f"
      say "installed ~/$f"
    fi
  done

  # waybar systemd user unit — Hyprland's lua startup runs `systemctl --user start waybar.service`
  if [ -f "$SRC/systemd/user/waybar.service" ]; then
    mkdir -p "$CFG/systemd/user"
    backup "$CFG/systemd/user/waybar.service"
    cp -a "$SRC/systemd/user/waybar.service" "$CFG/systemd/user/waybar.service"
    systemctl --user daemon-reload 2>/dev/null || true
    say "installed waybar.service user unit"
  fi

  # executable bits on the scripts
  chmod +x "$CFG"/hypr/*.sh "$CFG/themes/set-theme.sh" 2>/dev/null || true
  chmod +x "$CFG"/waybar/scripts/*.sh 2>/dev/null || true

  # Apply the theme -> creates the stable symlinks that waybar/kitty/rofi/
  # hyprpaper/hyprlock import. Safe outside a session.
  if [ -x "$CFG/themes/set-theme.sh" ]; then
    say "Applying theme: $THEME"
    "$CFG/themes/set-theme.sh" "$THEME" \
      || warn "set-theme.sh reported an issue (expected if not in a Hyprland session yet)"
  fi

  say "Configs installed."
  echo "  • Log into Hyprland (or run 'hyprctl reload') to pick up the hypr configs."
  echo "  • Monitor layout comes from hypr/hosts/<hostname>.lua (falls back to default.lua);"
  echo "    add one for this machine in the repo if it needs its own layout."
}

# `./arch-hypr --dotfiles` : only (re)install the configs, then stop.
if [[ "${1:-}" == "--dotfiles" ]]; then
  install_dotfiles
  exit 0
fi

