[Unit]
Description=Waybar (auto-restart on crash)
Documentation=https://github.com/Alexays/Waybar/wiki/
# Part of the graphical session: stops at logout. Started from the Hyprland
# startup hook in hyprland.lua (works with or without uwsm).
PartOf=graphical-session.target
After=graphical-session.target
# Default crash-rate guard: give up if it dies 5 times within 10s
# (prevents a respawn storm if it ever crashes on startup).
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/waybar
ExecReload=/usr/bin/kill -SIGUSR2 $MAINPID
# Auto-restart after the known mpris/playerctl segfault.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
